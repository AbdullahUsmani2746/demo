}

model ApprovalRequest {
  id             Int           @id @default(autoincrement())
  rule_id        Int?
  rule_name      String?       @db.VarChar(150)
  doc_type       String        @db.VarChar(60)
  tran_code      Int?
  kind           String        @default("voucher") @db.VarChar(10) // voucher | order
  action         String        @default("create") @db.VarChar(10) // create | update
  target_id      String?       @db.VarChar(60) // the document an edit is for
  status         String        @default("pending") @db.VarChar(20)
  payload        Json
  ui_state       Json?
  summary        String?       @db.VarChar(500)
  requested_by   String        @db.VarChar(50)
  requested_at   DateTime      @default(now())
  decided_by     String?       @db.VarChar(50)
  decided_at     DateTime?
  remarks        String?       @db.VarChar(500)
  posted_tran_id Int?
  posted_no      String?       @db.VarChar(60)
  post_error     String?       @db.VarChar(500)
  updated_at     DateTime      @default(now()) @updatedAt
  // HR approval chain (lib/hr/chains.js): where the request is in its chain
  chain_id       Int?
  chain_step     Int?
  step_users     String[]      @default([]) // who acts on the current step
  watchers       String[]      @default([]) // told at every step
  chain_actors   String[]      @default([]) // everyone who acted on it
  chain_log      Json          @default("[]")
  chain          Json? // a rule's steps copied when the entry was held (lib/approvals/docChains.js)
  rule           ApprovalRule? @relation(fields: [rule_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([requested_by])
  @@index([rule_id])
  @@index([kind, target_id, status], map: "ApprovalRequest_target_idx")
}

/// HR approval chain — Admin → Permissions → Approvals → HR approval chains
/// (lib/hr/chains.js, prisma/sql/2026-11-19_hr_approval_chains.sql).
model HrApprovalChain {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(150)
  doc_type          String   @db.VarChar(30) // hrLeave | hrLoan
  loan_kind         String?  @db.VarChar(20) // ADVANCE | LOAN | null = both
  work_location_ids Int[]    @default([]) // empty = every location
  department_ids    Int[]    @default([]) // empty = every department
  steps             Json     @default("[]")
  watchers          Json     @default("[]")
  is_active         Boolean  @default(true)
  sort              Int      @default(0)
  created_by        String?  @db.VarChar(50)
  created_at        DateTime @default(now()) @db.Timestamp(3)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamp(3)

  @@index([doc_type, is_active])
  @@map("hr_approval_chains")
}

model MenuBlock {
  id         Int      @id @default(autoincrement())
  menu_id    Int
  user_id    String?  @db.VarChar(50)
  role       String?  @db.VarChar(30)
  created_by String?  @db.VarChar(50)
  created_at DateTime @default(now())
  menu       menus    @relation(fields: [menu_id], references: [id], onDelete: Cascade)

  @@unique([menu_id, user_id])
  @@unique([menu_id, role])
  @@index([user_id])
  @@index([role])
}

model DepartmentScope {
  id           String     @id @default(cuid())
  departmentId Int
  dimension    String     @db.VarChar(30)
  mode         String     @db.VarChar(10) // ALL | LIST
  values       String[]   @default([])
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, dimension])
  @@index([departmentId])
}

/// Service Invoice line ↔ the GRNs / dispatches the service was for
/// (lib/service/serviceInvoice.js). Tracking and reports only — the cost is
/// posted to the service's expense account.
model ServiceInvoiceLink {
  id             Int      @id @default(autoincrement())
  tran_id        Int // the Service Invoice (TRANSACTIONS_MASTER.tran_id)
  line_no        Int // its service line, 1-based
  source_tran_id Int // the linked GRN (tran_code 4) or dispatch (tran_code 6)
  source_type    String   @db.VarChar(20) // GRN | DISPATCH | SALE_RETURN
  created_at     DateTime @default(now())

  @@unique([tran_id, line_no, source_tran_id])
  @@index([tran_id])
  @@index([source_tran_id])
  @@map("service_invoice_links")
}

// ── Ported from eastland 2026-10-25: BI dashboards, designer, follow-ups ──
// ── BI: questions, dashboards, who sees them (lib/bi/*) ─────────────────────
// A saved question: dataset + measures + group-by + filters + visual, as JSON
// (lib/bi/engine.js documents the shape). No SQL is ever stored.
model BiQuestion {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(150)
  description String?      @db.VarChar(500)
  dataset     String       @db.VarChar(50)
  config      Json
  created_by  String?      @db.VarChar(50)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  followups   BiFollowup[]

  @@index([dataset])
}

// A flagged row of a question that someone must act on (config.followup) —
// prisma/sql/2026-10-24_bi_followups.sql, lib/bi/followups.js.
model BiFollowup {
  id          Int              @id @default(autoincrement())
  question_id Int
  item_key    String           @db.VarChar(150)
  item_label  String?          @db.VarChar(400)
  flag_label  String?          @db.VarChar(80)
  owner_id    String?          @db.VarChar(50)
  party_id    Int?
  status      String           @default("open") @db.VarChar(20) // open | done | cleared
  result      String?          @db.VarChar(20) // approved | not_suitable | more_time | other
  next_date   DateTime?
  remarks     String?          @db.VarChar(1000)
  due_since   DateTime         @default(now())
  last_seen   DateTime         @default(now())
  level       Int              @default(0)
  done_at     DateTime?
  done_by     String?          @db.VarChar(50)
  created_at  DateTime         @default(now())
  updated_at  DateTime         @default(now()) @updatedAt
  question    BiQuestion       @relation(fields: [question_id], references: [id], onDelete: Cascade)
  notes       BiFollowupNote[]

  @@unique([question_id, item_key])
  @@index([owner_id, status])
  @@index([status])
  @@index([party_id, status])
}

model BiFollowupNote {
  id          Int        @id @default(autoincrement())
  followup_id Int
  user_id     String?    @db.VarChar(50)
  result      String?    @db.VarChar(20)
  remarks     String?    @db.VarChar(1000)
  created_at  DateTime   @default(now())
  followup    BiFollowup @relation(fields: [followup_id], references: [id], onDelete: Cascade)

  @@index([followup_id])
}

// A page of questions: layout = { sections: [{ title, items: [{ questionId, width }] }] }
/// Dated notes shown as flags on dashboard trend charts — prisma/sql/2026-11-17_bi_events.sql
model BiEvent {
  id         Int      @id @default(autoincrement())
  dated      DateTime @db.Date
  label      String   @db.VarChar(60)
  note       String?  @db.VarChar(300)
  created_by String?  @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamp(3)

  @@index([dated])
  @@map("bi_events")
}

model BiDashboard {
  id             Int                     @id @default(autoincrement())
  name           String                  @db.VarChar(150)
  description    String?                 @db.VarChar(500)
  layout         Json
  default_period String                  @default("mtd") @db.VarChar(20)
  is_active      Boolean                 @default(true)
  created_by     String?                 @db.VarChar(50)
  created_at     DateTime                @default(now())
  updated_at     DateTime                @updatedAt
  assignments    BiDashboardAssignment[]
}

// Who sees a dashboard: one of department / role / user per row.
model BiDashboardAssignment {
  id            Int         @id @default(autoincrement())
  dashboard_id  Int
  department_id Int?
  role          String?     @db.VarChar(30)
  user_id       String?     @db.VarChar(50)
  is_landing    Boolean     @default(false)
  dashboard     BiDashboard @relation(fields: [dashboard_id], references: [id], onDelete: Cascade)

  @@index([dashboard_id])
  @@index([department_id])
  @@index([user_id])
}

// Which datasets a department may use. A department with no rows → all.
model BiDatasetAccess {
  id            Int    @id @default(autoincrement())
  department_id Int
  dataset       String @db.VarChar(50)

  @@unique([department_id, dataset])
}

// ── HR · Attendance (prisma/sql/2026-10-30_hr_attendance.sql) ───────────────
// Times of day are "HH:MM" (24h) in Asia/Karachi; instants (check_in, punch_time)
// are stored as UTC like every other DateTime. lib/hr/time.js converts.

/// HR → Shifts & Holidays. A shift whose end is before its start runs past midnight.
model HrShift {
  id                     Int                 @id @default(autoincrement())
  code                   String              @unique @db.VarChar(20)
  name                   String              @db.VarChar(100)
  start_time             String              @db.VarChar(5)
  end_time               String              @db.VarChar(5)
  break_minutes          Int                 @default(0)
  grace_minutes          Int                 @default(10) // late only after this
  early_grace_minutes    Int                 @default(10) // leaving this much early is not "early"
  half_day_late_minutes  Int                 @default(120) // arriving later than this = half day (0 = never)
  half_day_minutes       Int                 @default(240) // worked less than this = absent (0 = never)
  full_day_minutes       Int                 @default(0) // worked less than this = half day (0 = shift length − break)
  overtime_enabled       Boolean             @default(true)
  overtime_after_minutes Int                 @default(30) // overtime counts once out is this far past the end
  lates_per_day_cut      Int                 @default(3) // every N lates in a month = 1 day cut (0 = no cut)
  early_counts_as_late   Boolean             @default(true)
  week_off_days          Int[]               @default([0]) // 0 = Sunday … 6 = Saturday
  off_day_work           String              @default("COMP_OFF") @db.VarChar(10) // unplanned work on a week-off / holiday: COMP_OFF (earns a day) | OVERTIME
  color                  String              @default("#800000") @db.VarChar(9)
  is_active              Boolean             @default(true)
  created_by             String?             @db.VarChar(50)
  created_at             DateTime            @default(now())
  updated_at             DateTime            @default(now()) @updatedAt
  assignments            HrShiftAssignment[]
  attendance             HrAttendance[]

  @@map("hr_shifts")
}

/// Which shift an employee works from a date on (latest effective_from ≤ day wins).
model HrShiftAssignment {
  id                Int      @id @default(autoincrement())
  employee_id       Int
  shift_id          Int
  effective_from    DateTime @db.Date
  week_off_override Boolean  @default(false) // true = week_off_days below instead of the shift's
  week_off_days     Int[]    @default([])
  created_by        String?  @db.VarChar(50)
  created_at        DateTime @default(now())
  employee          Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  shift             HrShift  @relation(fields: [shift_id], references: [id])

  @@unique([employee_id, effective_from])
  @@index([shift_id])
  @@map("hr_shift_assignments")
}

model HrHoliday {
  id         Int      @id @default(autoincrement())
  date       DateTime @unique @db.Date
  name       String   @db.VarChar(100)
  is_paid    Boolean  @default(true)
  created_by String?  @db.VarChar(50)
  created_at DateTime @default(now())

  @@map("hr_holidays")
}

/// One row per employee per day that has anything recorded. A working day with
/// no row is absent; week-offs and holidays are derived (lib/hr/attendance/sheet.js).
model HrAttendance {
  id               Int             @id @default(autoincrement())
  employee_id      Int
  date             DateTime        @db.Date
  shift_id         Int?
  check_in         DateTime?
  check_out        DateTime?
  status           String          @db.VarChar(12) // PRESENT LATE HALF_DAY ABSENT LEAVE OFF HOLIDAY
  status_override  Boolean         @default(false) // a person set the status; times do not change it
  late_minutes     Int             @default(0)
  early_minutes    Int             @default(0)
  worked_minutes   Int             @default(0)
  overtime_minutes Int             @default(0)
  needs_review     Boolean         @default(false) // e.g. only one punch
  source           String          @default("MANUAL") @db.VarChar(10) // MANUAL | DEVICE | IMPORT
  remarks          String?         @db.VarChar(300)
  locked           Boolean         @default(false) // payroll posted for this day
  leave_type_id    Int? // status LEAVE: which leave (balance used = these rows)
  leave_half       Boolean         @default(false) // half-day leave: ½ leave + ½ worked
  leave_request_id Int? // written by an approved leave request (edit it there, not here)
  created_by       String?         @db.VarChar(50)
  updated_by       String?         @db.VarChar(50)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @default(now()) @updatedAt
  employee         Employee        @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  shift            HrShift?        @relation(fields: [shift_id], references: [id])
  leaveType        HrLeaveType?    @relation(fields: [leave_type_id], references: [id])
  leaveRequest     HrLeaveRequest? @relation(fields: [leave_request_id], references: [id], onDelete: SetNull)

  @@unique([employee_id, date])
  @@index([date])
  @@index([leave_type_id])
  @@index([leave_request_id])
  @@map("hr_attendance")
}

/// Raw clock-ins from a machine or a file. Attendance rows are built from these.
model HrPunch {
  id             Int       @id @default(autoincrement())
  device_user_id String    @db.VarChar(30)
  employee_id    Int? // resolved from Employee.attendanceId (or id) when known
  punch_time     DateTime
  device_id      Int?
  source         String    @default("DEVICE") @db.VarChar(10) // DEVICE | IMPORT
  batch          String?   @db.VarChar(40)
  created_at     DateTime  @default(now())
  device         HrDevice? @relation(fields: [device_id], references: [id], onDelete: SetNull)

  @@unique([device_user_id, punch_time])
  @@index([employee_id, punch_time])
  @@index([punch_time])
  @@map("hr_punches")
}

/// ZKTeco machines reachable from the server (TCP 4370 by default).
model HrDevice {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(100)
  ip              String    @db.VarChar(64)
  port            Int       @default(4370)
  location        String?   @db.VarChar(100)
  auto_sync       Boolean   @default(true)
  is_active       Boolean   @default(true)
  last_sync_at    DateTime?
  last_sync_ok    Boolean?
  last_sync_count Int       @default(0)
  last_sync_error String?   @db.VarChar(300)
  created_by      String?   @db.VarChar(50)
  created_at      DateTime  @default(now())
  punches         HrPunch[]

  @@map("hr_devices")
}

// ── HR · Leave (prisma/sql/2026-10-31_hr_leave.sql) ─────────────────────────
// Entitlement is worked out from the type (lib/hr/leave/policy.js); leave USED
// is the attendance rows marked with the type; balances hold only what a person
// adds: carry-forward and adjustments.

/// HR → Leave → Leave types.
model HrLeaveType {
  id                   Int              @id @default(autoincrement())
  code                 String           @unique @db.VarChar(20)
  name                 String           @db.VarChar(100)
  is_paid              Boolean          @default(true)
  annual_days          Float            @default(0) // entitlement per leave year
  accrual              String           @default("YEARLY") @db.VarChar(10) // YEARLY (all at once) | MONTHLY (1/12 a month)
  prorate_joiners      Boolean          @default(true) // YEARLY: a joiner gets the months left
  min_service_days     Int              @default(0) // usable only after this long in service
  max_carry_forward    Float            @default(0) // days that move to next year
  allow_negative       Boolean          @default(false) // may go below zero (e.g. unpaid leave)
  allow_half_day       Boolean          @default(true)
  count_off_days       Boolean          @default(false) // week-offs / holidays inside a leave count as leave
  max_days_per_request Float? // null = no limit
  comp_off             Boolean          @default(false) // spent from comp-off days earned (lib/hr/leave/compOff.js), not a yearly entitlement
  comp_off_valid_days  Int              @default(30) // a comp-off day must be taken within this many days of earning it
  encashable           Boolean          @default(false) // balance paid out in the final settlement (rule: HR → Payroll → Rules)
  gender               String?          @db.VarChar(10) // Male | Female | null = everyone
  color                String           @default("#0284c7") @db.VarChar(9)
  sort                 Int              @default(0)
  is_active            Boolean          @default(true)
  created_at           DateTime         @default(now())
  updated_at           DateTime         @default(now()) @updatedAt
  balances             HrLeaveBalance[]
  requests             HrLeaveRequest[]
  attendance           HrAttendance[]

  @@map("hr_leave_types")
}

/// What a person added to a leave year: carried forward + adjustments.
model HrLeaveBalance {
  id            Int         @id @default(autoincrement())
  employee_id   Int
  leave_type_id Int
  year          Int // leave year label (the year it starts in)
  carry_forward Float       @default(0)
  adjustment    Float       @default(0) // + extra days granted / − days taken away
  note          String?     @db.VarChar(300)
  updated_by    String?     @db.VarChar(50)
  updated_at    DateTime    @default(now()) @updatedAt
  employee      Employee    @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  leaveType     HrLeaveType @relation(fields: [leave_type_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, leave_type_id, year])
  @@map("hr_leave_balances")
}

/// Planned off-day swap: works work_date (a week-off / holiday), off on off_date
/// instead. Approved → the sheet reads them that way (lib/hr/attendance/swaps.js).
model HrOffSwap {
  id                  Int       @id @default(autoincrement())
  employee_id         Int
  work_date           DateTime  @db.Date
  off_date            DateTime  @db.Date
  reason              String?   @db.VarChar(500)
  status              String    @default("pending") @db.VarChar(12) // pending | approved | rejected | cancelled
  approval_request_id Int?
  requested_by        String    @db.VarChar(50)
  requested_at        DateTime  @default(now())
  decided_by          String?   @db.VarChar(50)
  decided_at          DateTime?
  decision_note       String?   @db.VarChar(500)
  updated_at          DateTime  @default(now()) @updatedAt
  employee            Employee  @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id, work_date])
  @@index([employee_id, off_date])
  @@index([status])
  @@map("hr_off_swaps")
}

/// A leave application. Approved → its days are written to hr_attendance.
model HrLeaveRequest {
  id                  Int            @id @default(autoincrement())
  employee_id         Int
  leave_type_id       Int
  from_date           DateTime       @db.Date
  to_date             DateTime       @db.Date
  half_day            Boolean        @default(false) // only when from = to
  days                Float // working days it takes (week-offs / holidays left out unless the type counts them)
  reason              String?        @db.VarChar(500)
  status              String         @default("pending") @db.VarChar(12) // pending | approved | rejected | cancelled
  approval_request_id Int?
  requested_by        String         @db.VarChar(50)
  requested_at        DateTime       @default(now())
  decided_by          String?        @db.VarChar(50)
  decided_at          DateTime?
  decision_note       String?        @db.VarChar(500)
  updated_at          DateTime       @default(now()) @updatedAt
  employee            Employee       @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  leaveType           HrLeaveType    @relation(fields: [leave_type_id], references: [id])
  attendance          HrAttendance[]

  @@index([employee_id, from_date])
  @@index([status])
  @@map("hr_leave_requests")
}

// ── HR · Salary & loans (prisma/sql/2026-11-01_hr_salary_loans.sql) ──────────

/// Allowances and deductions that make up a salary (HR → Salary → Pay components).
/// Statutory items (EOBI, income tax) and loan recoveries are worked out by payroll.
model HrPayComponent {
  id            Int            @id @default(autoincrement())
  code          String         @unique @db.VarChar(20)
  name          String         @db.VarChar(100)
  kind          String         @db.VarChar(10) // EARNING | DEDUCTION
  calc          String         @default("FIXED") @db.VarChar(15) // FIXED | PERCENT_BASIC
  default_value Float          @default(0) // amount, or % of basic
  prorate       Boolean        @default(true) // paid by days worked (paid days / days in month)
  taxable       Boolean        @default(true) // earnings: part of taxable income
  gl_acno       Int? // payroll JV account (blank = Finance → Account Settings default)
  sort          Int            @default(0)
  is_active     Boolean        @default(true)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @default(now()) @updatedAt
  lines         HrSalaryLine[]

  @@map("hr_pay_components")
}

/// An employee's salary from a date. A revision is pending until approved;
/// the latest ACTIVE one with effective_from ≤ a day is the salary that day.
model HrSalaryStructure {
  id                  Int            @id @default(autoincrement())
  employee_id         Int
  effective_from      DateTime       @db.Date
  basic               Float
  status              String         @default("active") @db.VarChar(12) // pending | active | rejected | cancelled
  reason              String?        @db.VarChar(500)
  approval_request_id Int?
  created_by          String?        @db.VarChar(50)
  created_at          DateTime       @default(now())
  decided_by          String?        @db.VarChar(50)
  decided_at          DateTime?
  decision_note       String?        @db.VarChar(500)
  employee            Employee       @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  lines               HrSalaryLine[]

  @@index([employee_id, effective_from])
  @@index([status])
  @@map("hr_salary_structures")
}

model HrSalaryLine {
  id           Int               @id @default(autoincrement())
  structure_id Int
  component_id Int
  value        Float // amount, or % of basic (component.calc)
  structure    HrSalaryStructure @relation(fields: [structure_id], references: [id], onDelete: Cascade)
  component    HrPayComponent    @relation(fields: [component_id], references: [id])

  @@unique([structure_id, component_id])
  @@map("hr_salary_lines")
}

/// Salary advance or loan, recovered in monthly instalments by payroll.
/// Outstanding = amount − recoveries. Due in a month = min(instalment,
/// outstanding) from start_month on, except skipped months (lib/hr/loans/schedule.js).
model HrLoan {
  id                  Int              @id @default(autoincrement())
  employee_id         Int
  kind                String           @db.VarChar(10) // ADVANCE | LOAN
  amount              Float
  installment         Float // recovered each month
  start_month         String           @db.VarChar(7) // YYYY-MM of the first recovery
  skip_months         String[]         @default([]) // YYYY-MM months not recovered
  reason              String?          @db.VarChar(500)
  status              String           @default("pending") @db.VarChar(12) // pending | active | settled | rejected | cancelled
  approval_request_id Int?
  disbursed_on        DateTime?        @db.Date
  disbursement_ref    String?          @db.VarChar(60) // cheque / transfer reference
  disburse_tran_id    Int? // the Payment voucher that paid it out (lib/hr/vouchers.js)
  disburse_acno       Int? // cash / bank account it was paid from
  requested_by        String           @db.VarChar(50)
  requested_at        DateTime         @default(now())
  decided_by          String?          @db.VarChar(50)
  decided_at          DateTime?
  decision_note       String?          @db.VarChar(500)
  updated_at          DateTime         @default(now()) @updatedAt
  employee            Employee         @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  recoveries          HrLoanRecovery[]
  events              HrLoanEvent[]

  @@index([employee_id])
  @@index([status])
  @@map("hr_loans")
}

model HrLoanRecovery {
  id         Int      @id @default(autoincrement())
  loan_id    Int
  date       DateTime @db.Date
  month      String?  @db.VarChar(7) // payroll month it was deducted in
  amount     Float
  source     String   @db.VarChar(10) // PAYROLL | CASH
  reference  String?  @db.VarChar(60)
  payroll_id Int? // hr_payroll_runs.id when recovered by payroll
  settlement_id Int? // hr_settlements.id when recovered by a final settlement (source SETTLEMENT)
  tran_id    Int? // CASH: the Receipt voucher (lib/hr/vouchers.js)
  cash_acno  Int? // CASH: cash / bank account it was received into
  created_by String?  @db.VarChar(50)
  created_at DateTime @default(now())
  loan       HrLoan   @relation(fields: [loan_id], references: [id], onDelete: Cascade)

  @@index([loan_id])
  @@map("hr_loan_recoveries")
}

/// What happened to a loan, for its timeline.
model HrLoanEvent {
  id         Int      @id @default(autoincrement())
  loan_id    Int
  action     String   @db.VarChar(30)
  detail     String?  @db.VarChar(500)
  created_by String?  @db.VarChar(50)
  created_at DateTime @default(now())
  loan       HrLoan   @relation(fields: [loan_id], references: [id], onDelete: Cascade)

  @@index([loan_id])
  @@map("hr_loan_events")
}

// ── HR · Payroll (prisma/sql/2026-11-02_hr_payroll.sql) ─────────────────────

/// A month's payroll for a set of employees.
/// DRAFT → (submit) PENDING → (approve) APPROVED → (post) POSTED → (reverse) REVERSED.
model HrPayrollRun {
  id                  Int                @id @default(autoincrement())
  month               String             @db.VarChar(7) // YYYY-MM
  title               String?            @db.VarChar(150)
  pay_date            DateTime           @db.Date // date of the journal voucher
  status              String             @default("DRAFT") @db.VarChar(10)
  notes               String?            @db.VarChar(500)
  employees           Int                @default(0)
  total_earnings      Float              @default(0)
  total_deductions    Float              @default(0)
  total_net           Float              @default(0)
  total_employer      Float              @default(0) // employer EOBI
  approval_request_id Int?
  jv_tran_id          Int?
  jv_vr_no            Int?
  reversal_tran_id    Int?
  created_by          String?            @db.VarChar(50)
  created_at          DateTime           @default(now())
  computed_at         DateTime?
  submitted_by        String?            @db.VarChar(50)
  submitted_at        DateTime?
  decided_by          String?            @db.VarChar(50)
  decided_at          DateTime?
  decision_note       String?            @db.VarChar(500)
  posted_by           String?            @db.VarChar(50)
  posted_at           DateTime?
  reversed_by         String?            @db.VarChar(50)
  reversed_at         DateTime?
  reverse_reason      String?            @db.VarChar(500)
  updated_at          DateTime           @default(now()) @updatedAt
  payslips            HrPayslip[]
  payments            HrPayrollPayment[]

  @@index([month])
  @@index([status])
  @@map("hr_payroll_runs")
}

/// Net salaries of a posted payroll paid out: one Payment voucher each
/// (Dr salaries payable, Cr cash / bank). Undone by a reversal journal, never
/// deleted (prisma/sql/2026-11-04_hr_accounting.sql).
model HrPayrollPayment {
  id               Int          @id @default(autoincrement())
  run_id           Int
  date             DateTime     @db.Date
  acno             Int // cash / bank account paid from
  amount           Float
  employees        Int[]        @default([]) // employees paid by it (empty = the rest of the run)
  reference        String?      @db.VarChar(60) // cheque / bank transfer
  tran_id          Int // the Payment voucher
  reversal_tran_id Int?
  reversed_by      String?      @db.VarChar(50)
  reversed_at      DateTime?
  reverse_reason   String?      @db.VarChar(500)
  created_by       String?      @db.VarChar(50)
  created_at       DateTime     @default(now())
  run              HrPayrollRun @relation(fields: [run_id], references: [id], onDelete: Restrict)

  @@index([run_id])
  @@map("hr_payroll_payments")
}

/// One employee in a run: the full calculation (data) plus the figures the
/// journal, reports and next months' tax read.
model HrPayslip {
  id               Int          @id @default(autoincrement())
  run_id           Int
  employee_id      Int
  month            String       @db.VarChar(7)
  data             Json // breakdown (lib/hr/payroll/compute.js)
  adjustments      Json         @default("[]") // one-off earnings / deductions entered on the run
  loan_overrides   Json         @default("{}") // { loanId: amount } instead of the instalment due
  hold             Boolean      @default(false) // salary on hold (not in the bank sheet)
  paid_days        Float        @default(0)
  total_earnings   Float        @default(0)
  total_deductions Float        @default(0)
  net              Float        @default(0)
  taxable          Float        @default(0)
  income_tax       Float        @default(0)
  eobi_employee    Float        @default(0)
  eobi_employer    Float        @default(0)
  pf_employee      Float        @default(0) // provident fund, employee share (deducted) — feature hr.providentFund
  pf_employer      Float        @default(0) // provident fund, employer share (cost)
  gratuity         Float        @default(0) // gratuity provision of the month (feature hr.gratuity, monthly accrual)
  warnings         String[]     @default([])
  run              HrPayrollRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  employee         Employee     @relation(fields: [employee_id], references: [id])

  @@unique([run_id, employee_id])
  @@index([employee_id, month])
  @@map("hr_payslips")
}

/// Salaried income-tax slabs per fiscal year (July–June; fiscal_year = the year it starts).
/// Tax = fixed_amount + rate_percent % of income above from_amount.
model HrTaxSlab {
  id           Int    @id @default(autoincrement())
  fiscal_year  Int
  from_amount  Float
  to_amount    Float? // null = no upper limit
  fixed_amount Float  @default(0)
  rate_percent Float  @default(0)

  @@index([fiscal_year])
  @@map("hr_tax_slabs")
}

// ── HR · Leaving & final settlement (prisma/sql/2026-11-21_hr_payroll_additions.sql) ──

/// A resignation / termination / retirement (feature hr.leavingProcess).
/// pending (Approvals, hrSeparation) → approved (clearance) → completed
/// (Employee.dor + status set) · rejected · cancelled.
model HrSeparation {
  id                  Int            @id @default(autoincrement())
  employee_id         Int
  kind                String         @db.VarChar(12) // RESIGNATION | TERMINATION | RETIREMENT
  notice_date         DateTime       @db.Date // day notice was given
  notice_days         Int            @default(0) // notice required (setting at the time)
  last_working_day    DateTime       @db.Date // becomes Employee.dor on completion
  waive_notice        Boolean        @default(false) // short notice neither recovered nor paid
  reason              String?        @db.VarChar(500)
  status              String         @default("pending") @db.VarChar(10)
  clearance           Json           @default("[]") // [{ key, label, done, by, at, note }] from setting hr.leaving.clearance_items
  approval_request_id Int?
  requested_by        String         @db.VarChar(50)
  requested_at        DateTime       @default(now())
  decided_by          String?        @db.VarChar(50)
  decided_at          DateTime?
  decision_note       String?        @db.VarChar(500)
  completed_by        String?        @db.VarChar(50)
  completed_at        DateTime?
  updated_at          DateTime       @default(now()) @updatedAt
  employee            Employee       @relation(fields: [employee_id], references: [id])
  settlements         HrSettlement[]

  @@index([employee_id])
  @@index([status])
  @@map("hr_separations")
}

/// Full & final settlement of a separation.
/// DRAFT → PENDING (Approvals, hrSettlement) → APPROVED → POSTED (JV, HR_SETTLEMENT)
/// → paid (Payment voucher, HR_SETTLEMENT_PAY) · REVERSED (mirror journal).
model HrSettlement {
  id                  Int          @id @default(autoincrement())
  separation_id       Int
  employee_id         Int
  dor                 DateTime     @db.Date
  salary_from         DateTime?    @db.Date // first day of the last salary it pays (payroll leaves these months out)
  status              String       @default("DRAFT") @db.VarChar(10)
  inputs              Json         @default("{}") // { unpaid_days, tax, adjustments[] } entered by HR
  data                Json         @default("{}") // breakdown (lib/hr/leaving/settlement.js)
  total_earnings      Float        @default(0)
  total_deductions    Float        @default(0)
  net                 Float        @default(0)
  approval_request_id Int?
  jv_tran_id          Int?
  reversal_tran_id    Int?
  pay_tran_id         Int?
  pay_acno            Int?
  paid_on             DateTime?    @db.Date
  pay_reversal_tran_id Int?
  created_by          String?      @db.VarChar(50)
  created_at          DateTime     @default(now())
  submitted_by        String?      @db.VarChar(50)
  submitted_at        DateTime?
  decided_by          String?      @db.VarChar(50)
  decided_at          DateTime?
  decision_note       String?      @db.VarChar(500)
  posted_by           String?      @db.VarChar(50)
  posted_at           DateTime?
  paid_by             String?      @db.VarChar(50)
  reversed_by         String?      @db.VarChar(50)
  reversed_at         DateTime?
  reverse_reason      String?      @db.VarChar(500)
  updated_at          DateTime     @default(now()) @updatedAt
  separation          HrSeparation @relation(fields: [separation_id], references: [id], onDelete: Restrict)
  employee            Employee     @relation(fields: [employee_id], references: [id])

  @@index([separation_id])
  @@index([employee_id])
  @@index([status])
  @@map("hr_settlements")
}


// Sub accounts of a ledger account (Features: vouchers.subAccounts) — from Eastland
model subAccount {
  id      Int    @id @default(autoincrement())
  acno    Int
  acname  String @db.VarChar(250)
  account ACNO   @relation(fields: [acno], references: [acno], onDelete: Restrict)

  @@index([acno])
}

// Raw-material input rate per item for the RMC "Input Based" view — from Eastland
model RmcInputRate {
  id         Int      @id @default(autoincrement())
  itcd       Int      @unique
  rate       Float    @default(0)
  updated_by String?  @db.VarChar(50)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  item       Item     @relation(fields: [itcd], references: [itcd])
}

// Planned quantity per item, monthly or quarterly (Production Planning "Qtr Qty") — from Accounting
model InputForPP {
  id          Int      @id @default(autoincrement())
  itcd        Int
  period_type String   @default("MONTHLY") // MONTHLY | QUARTERLY
  month       Int      @default(0) // 1-12 for MONTHLY rows, 0 for QUARTERLY
  quarter     Int      @default(0) // 1-4 for QUARTERLY rows, 0 for MONTHLY
  year        Int
  qty         Float
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt
  item        Item     @relation(fields: [itcd], references: [itcd])

  @@unique([itcd, period_type, month, year, quarter], name: "itcd_period_type_month_year_quarter")
  @@index([itcd])
  @@index([month, year])
  @@index([quarter, year])
  @@map("INPUT_FOR_PP")
}
// ── Fixed Assets (prisma/sql/2026-11-20_fixed_assets.sql, lib/fixedAssets/*) ──
// Company defaults live in Settings key "fixedAssetSettings"
// (lib/fixedAssets/settingsDefs.js); account defaults in Account Settings
// (section FIXED_ASSETS). No Prisma relations on purpose — ids are joined in
// lib/fixedAssets so these tables never touch the shared models.

// Per fixed-asset CATEGORY (ItemCategory whose main category starts "FIXED
// ASSET"): depreciation defaults and posting accounts. Empty = the company
// default (Settings / Account Settings).
model FaCategoryDefault {
  ic_id              Int      @id
  method             String?  @db.VarChar(4) // SL | RB
  useful_life_months Int?
  rb_rate            Float? // reducing balance % a year
  salvage_pct        Float? // % of cost
  cost_acno          Int?
  accdep_acno        Int?
  depexp_acno        Int?
  gainloss_acno      Int?
  updated_by         String?  @db.VarChar(120)
  updated_at         DateTime @default(now()) @updatedAt

  @@map("fa_category_defaults")
}

// One row per asset unit (Fixed Assets GRN line, qty 1, asset_no). Method /
// life / rate / salvage empty = the category default, then the company one;
// editable until the asset's first depreciation is posted.
model FixedAsset {
  id                  Int       @id @default(autoincrement())
  asset_no            Int       @unique
  itcd                Int
  ic_id               Int?
  grn_tran_id         Int?
  grn_line_id         Int?      @unique
  vendor_acno         Int?
  description         String?   @db.VarChar(250)
  cost                Float     @default(0)
  in_service_date     DateTime  @db.Date
  method              String?   @db.VarChar(4) // SL | RB
  useful_life_months  Int?
  rb_rate             Float?
  salvage_value       Float?
  opening_accumulated Float     @default(0) // brought forward (assets taken on with history)
  department_id       Int?
  employee_id         Int?
  location_id         Int? // WorkLocation
  status              String    @default("IN_USE") @db.VarChar(10) // IN_USE | DISPOSED
  disposed_on         DateTime? @db.Date
  capitalisation_tran_id Int? // FA_CAPITALISATION journal of its GRN
  remarks             String?   @db.VarChar(500)
  created_by          String?   @db.VarChar(120)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @default(now()) @updatedAt

  @@index([itcd])
  @@index([ic_id])
  @@index([grn_tran_id])
  @@index([status])
  @@map("fixed_assets")
}

// Holder history: registration, relocation, disposal (and its reversal).
model FixedAssetMovement {
  id                 Int      @id @default(autoincrement())
  asset_id           Int
  kind               String   @db.VarChar(20) // ADDITION | RELOCATION | DISPOSAL | DISPOSAL_REVERSAL | HOLDER_CHANGE
  dated              DateTime @db.Date
  tran_id            Int?
  from_department_id Int?
  from_employee_id   Int?
  from_location_id   Int?
  to_department_id   Int?
  to_employee_id     Int?
  to_location_id     Int?
  remarks            String?  @db.VarChar(500)
  created_by         String?  @db.VarChar(120)
  created_at         DateTime @default(now())

  @@index([asset_id])
  @@index([tran_id])
  @@index([dated])
  @@map("fixed_asset_movements")
}

// One monthly depreciation run = one system journal (rmk4 FA_DEPRECIATION).
// A month has at most one POSTED run (partial unique index in the SQL file).
model FixedAssetDepreciationRun {
  id               Int       @id @default(autoincrement())
  period           String    @db.VarChar(7) // YYYY-MM
  status           String    @default("POSTED") @db.VarChar(10) // POSTED | REVERSED
  posting_date     DateTime  @db.Date
  jv_tran_id       Int?
  reversal_tran_id Int?
  total            Float     @default(0)
  asset_count      Int       @default(0)
  rules            Json? // the settings the run was worked out with
  posted_by        String?   @db.VarChar(120)
  posted_at        DateTime  @default(now())
  reversed_by      String?   @db.VarChar(120)
  reversed_at      DateTime?
  reverse_reason   String?   @db.VarChar(500)

  @@index([period])
  @@index([status])
  @@map("fixed_asset_depreciation_runs")
}

model FixedAssetDepreciationLine {
  id          Int    @id @default(autoincrement())
  run_id      Int
  asset_id    Int
  period      String @db.VarChar(7)
  factor      Float  @default(1) // share of the month charged (first / last month rule)
  opening_nbv Float
  amount      Float
  closing_nbv Float
  ic_id       Int?
  depexp_acno Int?
  accdep_acno Int?

  @@unique([run_id, asset_id])
  @@index([asset_id])
  @@index([period])
  @@map("fixed_asset_depreciation_lines")
}

// A disposal line (tran_code 15) worked out: cost, accumulated, NBV,
// proceeds, gain / loss and its system journal (rmk4 FA_DISPOSAL).
model FixedAssetDisposal {
  id               Int       @id @default(autoincrement())
  asset_id         Int
  tran_id          Int // the Fixed Asset Disposal voucher
  dated            DateTime  @db.Date
  kind             String    @db.VarChar(6) // SALE | SCRAP
  party_acno       Int?
  proceeds         Float     @default(0)
  cost             Float
  accumulated      Float // at disposal, incl. month_charge
  month_charge     Float     @default(0) // depreciation of the disposal month (last-month rule)
  nbv              Float
  gain_loss        Float // + gain, - loss
  jv_tran_id       Int?
  reversal_tran_id Int?
  reversed_by      String?   @db.VarChar(120)
  reversed_at      DateTime?
  reverse_reason   String?   @db.VarChar(500)
  created_at       DateTime  @default(now())

  @@index([asset_id])
  @@index([tran_id])
  @@index([dated])
  @@map("fixed_asset_disposals")
}

// ── Point of Sale (prisma/sql/2026-11-22_pos.sql, lib/pos/*) ────────────────
// A cashier's shift: opened with a float, closed with the cash counted. The Z
// report (lib/pos/shift.js) is worked out from the receipts of the shift and
// frozen into `summary` when it is closed.
model PosShift {
  id            Int       @id @default(autoincrement())
  user_id       String
  godown        Int?
  opened_at     DateTime  @default(now())
  opening_float Float     @default(0)
  closed_at     DateTime?
  closed_by     String?
  expected_cash Float?
  counted_cash  Float?
  difference    Float?
  notes         String?   @db.VarChar(500)
  status        String    @default("OPEN") @db.VarChar(10) // OPEN | CLOSED
  summary       Json?

  @@index([user_id, status])
  @@index([opened_at])
  @@map("pos_shifts")
}

// One row per POS receipt (sale = tran_code 5, return = tran_code 12): the
// figures the receipt prints. The books are the voucher itself.
model PosReceipt {
  tran_id        Int      @id
  kind           String   @db.VarChar(10) // SALE | RETURN
  shift_id       Int?
  ref_tran_id    Int? // RETURN: the sale it refunds
  customer_name  String?  @db.VarChar(150)
  customer_phone String?  @db.VarChar(40)
  subtotal       Float    @default(0)
  discount       Float    @default(0)
  tax            Float    @default(0)
  rounding       Float    @default(0)
  total          Float    @default(0)
  tendered       Float    @default(0)
  change_due     Float    @default(0)
  note           String?  @db.VarChar(500)
  client_ref     String?  @unique @db.VarChar(64) // idempotency key from the till (a retried save is not posted twice)
  created_at     DateTime @default(now())

  @@index([shift_id])
  @@index([ref_tran_id])
  @@map("pos_receipts")
}

// How a receipt was paid (or refunded): CASH | CARD | CREDIT.
model PosPayment {
  id        Int     @id @default(autoincrement())
  tran_id   Int
  method    String  @db.VarChar(10)
  acno      Int?
  amount    Float
  reference String? @db.VarChar(80)

  @@index([tran_id])
  @@map("pos_payments")
}

// A bill put on hold at the till, recalled later (any till of the same cashier).
model PosHeldBill {
  id         Int      @id @default(autoincrement())
  user_id    String
  label      String?  @db.VarChar(120)
  data       Json
  created_at DateTime @default(now())

  @@index([user_id])
  @@map("pos_held_bills")
}
