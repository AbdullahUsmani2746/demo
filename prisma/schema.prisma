generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model User {
  id                           String               @id @default(cuid())
  username                     String?              @unique @db.VarChar(25)
  name                         String?
  email                        String               @unique
  emailVerified                DateTime?
  password                     String?
  image                        String?
  // Primary role — an app_roles.code (prisma/sql/2026-11-16_roles.sql); more in user_roles
  role                         String               @default("EMPLOYEE") @db.VarChar(40)
  isActive                     Boolean              @default(true)
  shiftId                      Int?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  departmentId                 Int?
  phone                        String?
  employeeId                   Int?                 @unique
  accounts                     Account[]
  auditLogs                    AuditLog[]
  invoiceKnockoffsCreated      InvoiceKnockoff[]    @relation("KnockoffCreatedBy")
  invoiceKnockoffsReversed     InvoiceKnockoff[]    @relation("KnockoffReversedBy")
  invoiceKnockoffRunsTriggered InvoiceKnockoffRun[]
  notifications                Notification[]
  notificationRules            NotificationRule[]
  pushSubscriptions            PushSubscription[]
  orderMaster                  OrderMaster[]
  sessions                     Session[]
  transactionsMaster           TransactionsMaster[] @relation("UserTransactions")
  department                   Department?          @relation(fields: [departmentId], references: [id])
  employee                     Employee?            @relation(fields: [employeeId], references: [id])
  shift                        Shift?               @relation(fields: [shiftId], references: [id])
  checksInHand                 ChecksInHand[]       @relation("UserChecksInHand")
  permissionGrants             PermissionGrant[]
  fieldPolicies                FieldPolicy[]
  dataScopes                   DataScope[]
  permissionsGrantedByMe       PermissionGrant[]    @relation("PermissionGrantedBy")
  extraRoles                   UserRole[]

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
  @@index([email])
  @@index([username])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  model_name String   @db.VarChar(100)
  record_id  String   @db.VarChar(150)
  action     String   @db.VarChar(10)
  changes    Json?
  snapshot   Json?
  user_id    String?
  user_name  String?  @db.VarChar(100)
  dated      DateTime @default(now())
  /// The document the row belongs to (a voucher line → its voucher) — lib/audit/catalog.js
  doc_model  String?  @db.VarChar(100)
  doc_id     String?  @db.VarChar(150)
  /// One save = one batch (every row a request wrote)
  batch_id   String?  @db.VarChar(40)
  /// user | system (cron jobs, scripts)
  source     String?  @db.VarChar(10)
  user       User?    @relation(fields: [user_id], references: [id])

  @@index([model_name, record_id])
  @@index([dated])
  @@index([user_id])
  @@index([doc_model, doc_id])
  @@index([batch_id])
}

/// Admin-defined "when this changes, tell these people" (Admin → Notifications
/// → Alerts). Evaluated on every audited write — lib/notifications/alerts.js.
model NotificationAlert {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(150)
  description      String?   @db.VarChar(500)
  is_active        Boolean   @default(true)
  model_name       String    @db.VarChar(100) // Prisma model, e.g. TransactionsMaster
  actions          String[]  @default([]) // create | update | delete (empty = all)
  conditions       Json      @default("[]") // [{ field, op, value }]
  match            String    @default("all") @db.VarChar(3) // all | any
  recipients       Json      @default("{}") // { roles, users, departments, userFields }
  notify_actor     Boolean   @default(false)
  type             String    @default("info") @db.VarChar(10) // info | success | warning | error
  title_template   String    @db.VarChar(200)
  message_template String    @db.VarChar(500)
  created_by       String?   @db.VarChar(50)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt
  last_fired_at    DateTime?
  fire_count       Int       @default(0)

  @@index([model_name, is_active])
  @@map("notification_alerts")
}

model Shift {
  id        Int      @id @default(autoincrement())
  name      String
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@index([name])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
  @@index([token])
}

model MBSCD {
  mbscd       Int    @id @unique @default(autoincrement())
  mbscdDetail String @db.VarChar(100)
  bscdItems   BSCD[]

  @@index([mbscdDetail])
}

model BSCD {
  bscd       Int     @id @unique @default(autoincrement())
  mbscd      Int
  bscdDetail String  @db.VarChar(100)
  mainBscd   MBSCD   @relation(fields: [mbscd], references: [mbscd])
  macnoItems MACNO[]

  @@index([mbscd])
  @@index([bscdDetail])
}

model MACNO {
  macno    Int     @id @unique @default(autoincrement())
  bscd     Int
  macname  String  @db.VarChar(100)
  isActive Boolean @default(true) @map("is_active")
  bscdRef  BSCD    @relation(fields: [bscd], references: [bscd])
  accounts ACNO[]

  @@index([bscd])
  @@index([macname])
  @@index([isActive])
}

model ACNO {
  acno                  Int                     @id @unique @default(autoincrement())
  macno                 Int
  acname                String                  @db.VarChar(250)
  bankAccountNo         String?                 @map("bank_account_no") @db.VarChar(100)
  address               String?                 @db.VarChar(300)
  city                  String?                 @db.VarChar(50)
  phoneFax              String?                 @map("phone_fax") @db.VarChar(250)
  email                 String?                 @db.VarChar(250)
  website               String?                 @db.VarChar(250)
  crDays                Int?                    @map("cr_days")
  crDays2               Int?                    @map("cr_days2")
  areaCode              String?                 @map("area_code") @db.VarChar(10)
  stRate                Decimal?                @map("st_rate") @db.Decimal(15, 2)
  area                  String?                 @db.VarChar(50)
  category              String?                 @map("catagory") @db.VarChar(50)
  subCategory           String?                 @map("sub_catagory") @db.VarChar(25)
  country               String?                 @db.VarChar(25)
  customerBank          String?                 @map("customer_bank") @db.VarChar(250)
  customerBankAddr      String?                 @map("customer_bank_addr") @db.VarChar(300)
  stRegNo               String?                 @map("st_reg_no") @db.VarChar(50)
  stReg                 String?                 @map("st_reg") @db.VarChar(50)
  ntnNo                 String?                 @map("ntn_no") @db.VarChar(50)
  contactPerson         String?                 @map("contact_person") @db.VarChar(50)
  crLimit               Int?                    @map("cr_limit")
  salesArea             String?                 @map("sales_ares") @db.VarChar(50)
  tax_filing_status     String?                 @map("tax_filing_status") @db.VarChar(25)
  tax_law_code          Int?
  lock                  Boolean?                @default(false)
  isActive              Boolean                 @default(true) @map("is_active")
  customerStatus        String?                 @map("customer_status") @db.VarChar(50)
  reconStatus           String?                 @map("recon_status") @db.VarChar(20)
  reconciliationRemarks String?                 @map("reconciliation_remarks") @db.VarChar(500)
  ledgerAcno            Int?                    @map("ledger_acno") // legacy ACNO.LEDGER_ACNO = sales person SP_CODE (salesArea holds the resolved User.id)
  monthlyTargets        CustomerMonthlyTarget[]
  bonds                 InboundMaster[]
  items                 Item[]
  LCBeneficiaries       LCMaster[]              @relation("LCBeneficiary")
  LCAcno                LCMaster[]              @relation("LCAcno")
  oderMaster            OrderMaster[]
  partyManagement       PARTY_MANAGEMENT[]
  salesForecast         SALES_FORECAST[]        @relation("ACNO_SALES_FORECAST")
  salesItemCust         SALES_ITEM_CUST[]
  taxChallans           TaxChallan[]
  transactionsMaster    TransactionsMaster[]
  transactions          Transactions[]
  mainAccount           MACNO                   @relation(fields: [macno], references: [macno])
  taxes                 TaxLaws?                @relation("ACNO_TaxSetup", fields: [tax_law_code], references: [tax_law_code])
  checksInHand          ChecksInHand[]          @relation("ChecksInHandCustomer")
  checksDepositedHere   ChecksInHand[]          @relation("ChecksInHandDepositBank")
  subAccounts           subAccount[]
  taxLawAccounts        TaxLaws[]               @relation("TaxLawAccount")

  @@index([macno])
  @@index([acname])
  @@index([city])
  @@index([category])
  @@index([email])
  @@index([isActive])
  @@index([phoneFax])
  @@index([tax_law_code])
  @@index([salesArea])
  @@index([tax_filing_status])
  @@index([crDays])
  @@index([customerStatus])
  @@map("acno")
}

model CustomerMonthlyTarget {
  id                   Int       @id @default(autoincrement())
  acno                 Int
  lockedAt             DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  dated                DateTime
  lockedTargetRecovery Decimal?  @db.Decimal(15, 2)
  // Overdue BALANCE frozen at month end — how much this customer still owed
  // past their credit terms on the last day of `dated`'s month. The report
  // otherwise recomputes it live, so it drifts as later receipts land;
  // locking it keeps the month-end MIS reproducible.
  // Not the same measure as lockedTargetRecovery, which is cash collected.
  lockedOverdue        Decimal?  @map("locked_overdue") @db.Decimal(15, 2)
  targetQty            Decimal?  @db.Decimal(10, 2)
  targetRecovery       Decimal?  @db.Decimal(15, 2)
  customer             ACNO      @relation(fields: [acno], references: [acno])

  @@unique([acno, dated])
  @@index([acno])
  @@index([dated])
}

// ============================================================
// SALES LOAN REGISTER — goods a sales person lends to a customer
// ============================================================
// A memo record only: nothing here touches stock, the ledger, invoices or any
// report. acno / so_no / dispatch_tran_id / itcd are plain ids, deliberately
// with no relation to ACNO / OrderMaster / TRANSACTIONS_MASTER / Item, so this
// register can never block or alter those tables.
//
// Status is derived, never stored: per line, returned = SUM(returns.qty);
// Open → nothing back, Partial → some back, Returned → all back.
// A loan is Overdue when it is not fully returned by expected_return_date.
// A loan is between TWO customers: goods out of customer A's (acno) Sale Order
// / Dispatch are given to customer B (to_acno), who returns them later.
model SalesLoan {
  id                   Int             @id @default(autoincrement())
  acno                 Int // FROM customer — whose Sale Order / Dispatch the goods come out of
  sales_person         String?         @db.VarChar(50) // User.id — the FROM customer's sales person when the loan was made
  to_acno              Int? // GIVEN TO customer — who receives the goods and returns them
  to_sales_person      String?         @db.VarChar(50) // User.id — the GIVEN TO customer's sales person (they see the loan too)
  so_no                Int? // optional Sale Order (of the FROM customer) the goods come from
  dispatch_tran_id     Int? // optional Dispatch (of the FROM customer) the goods come from
  issue_date           DateTime
  expected_return_date DateTime?
  purpose              String?         @db.VarChar(500)
  remarks              String?         @db.VarChar(1000)
  created_by           String?         @db.VarChar(50)
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt
  lines                SalesLoanLine[]

  @@index([acno])
  @@index([sales_person])
  @@index([to_acno])
  @@index([to_sales_person])
  @@index([issue_date])
  @@index([so_no])
  @@map("SALES_LOAN")
}

model SalesLoanLine {
  id         Int               @id @default(autoincrement())
  loan_id    Int
  itcd       Int
  qty_issued Float
  unit       String?           @db.VarChar(25)
  loan       SalesLoan         @relation(fields: [loan_id], references: [id], onDelete: Cascade)
  returns    SalesLoanReturn[]

  @@index([loan_id])
  @@index([itcd])
  @@map("SALES_LOAN_LINE")
}

model SalesLoanReturn {
  id          Int           @id @default(autoincrement())
  line_id     Int
  return_date DateTime
  qty         Float
  remarks     String?       @db.VarChar(500)
  created_by  String?       @db.VarChar(50)
  created_at  DateTime      @default(now())
  line        SalesLoanLine @relation(fields: [line_id], references: [id], onDelete: Cascade)

  @@index([line_id])
  @@index([return_date])
  @@map("SALES_LOAN_RETURN")
}

model SALES_ITEM_CUST {
  id          Int       @id @default(autoincrement())
  itcd        Int
  acno        Int
  rate        Float
  cust_itcd   Int?
  gst_rate    Float?
  dated       DateTime? @default(now())
  acnoDetails ACNO      @relation(fields: [acno], references: [acno])
  item        Item      @relation(fields: [itcd], references: [itcd])
  checked     Boolean?  @default(true) // shown on the Sale Order / ISO price list
  updated_by  String?   @db.VarChar(50)

  @@index([acno])
  @@index([itcd])
  @@index([acno, itcd])
  @@index([dated])
}

model SaleReturnRemark {
  id               Int       @id @default(autoincrement())
  tran_id          Int       @unique // TRANSACTIONS_MASTER.tran_id of the Sale Return
  reason_type      String    @db.VarChar(20) // TECHNICAL | COMMERCIAL
  remarks          String?   @db.VarChar(1000)
  status           String?   @db.VarChar(20) // TECHNICAL only: PENDING | APPROVED | REJECTED
  entered_by       String?   @db.VarChar(50) // User.id
  entered_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  decided_by       String?   @db.VarChar(50) // User.id of the approver
  decided_at       DateTime?
  decision_remarks String?   @db.VarChar(500)

  @@index([reason_type])
  @@index([status])
  @@map("SALE_RETURN_REMARK")
}

model Company {
  id                 Int                  @id @default(autoincrement())
  company            String?              @db.VarChar(100)
  addr1              String?              @db.VarChar(100)
  addr2              String?              @db.VarChar(100)
  city               String?              @db.VarChar(50)
  phone              String?              @db.VarChar(50)
  fax                String?              @db.VarChar(50)
  email              String?              @db.VarChar(50)
  logo               String?              @db.VarChar(255)
  Allowance          Allowance[]
  Bank               Bank[]
  bondLocations      BondLocation[]
  commissionTerms    CommissionTerm[]
  costCenters        CostCenter[]
  Deduction          Deduction[]
  deliveryModes      DeliveryMode[]
  deliveryTerms      DeliveryTerm[]
  departments        Department[]
  designations       Designation[]
  Employee           Employee[]
  financialYears     FinancialYear[]
  godowns            Godown[]
  Leave              Leave[]
  Manager            Manager[]
  poPrdCats          PoPrdCat[]
  seasons            Season[]
  TransactionsMaster TransactionsMaster[]
  users              Users[]
  WorkLocation       WorkLocation[]

  @@index([company])
}

model ProductMasterCategory {
  id            Int            @id @default(autoincrement())
  pmc_name      String?        @db.VarChar(250)
  productGroups ProductGroup[]

  @@index([pmc_name])
}

model ProductGroup {
  id                      Int                   @id @default(autoincrement())
  pg_name                 String?               @db.VarChar(250)
  pmc_id                  Int
  ProductMasterCategories ProductMasterCategory @relation(fields: [pmc_id], references: [id])

  @@index([pmc_id])
  @@index([pg_name])
}

model ProductCategory {
  id      Int     @id @default(autoincrement())
  pc_name String? @db.VarChar(250)
  items   Item[]

  @@index([pc_name])
}

model MainCategory {
  id             Int            @id @default(autoincrement())
  mc_name        String?        @db.VarChar(100)
  items          Item[]
  itemCategories ItemCategory[]

  @@index([mc_name])
}

model ItemCategory {
  id                   Int           @id @default(autoincrement())
  ic_name              String        @db.VarChar(250)
  wc_category_id       Int?          @unique
  stock_acno           Int?
  sale_acno            Int?
  nogodown_sale_acno   Int? // sale account of a "Despatch Without Godown" Sale Order (no default) — lib/dispatch/withoutGodown.js
  pos_acno             Int?
  cogs_acno            Int?
  cogm_acno            Int?
  // Per-category posting accounts; empty = the Account Settings default
  // (lib/accounts/itemAccounts.js).
  purchase_acno        Int?
  sale_return_acno     Int?
  purchase_return_acno Int?
  sales_tax_acno       Int?
  purchase_tax_acno    Int?
  pm_cost_acno         Int? // legacy ITEM_CATAGORY.PM_COST_ACNO
  ccno                 Int? // legacy ITEM_CATAGORY.CCNO
  sync_status          String?       @default("synced") @db.VarChar(20)
  last_sync            DateTime?     @default(now())
  mainCategoryId       Int?
  items                Item[]
  mainCategory         MainCategory? @relation(fields: [mainCategoryId], references: [id])
  grn_direct_rate      Boolean       @default(false) // its items take the GRN rate (Features: grn.directRateByItem)

  @@index([ic_name])
  @@index([sync_status])
}

model Subtrates {
  id          Int     @id @default(autoincrement())
  subtrate    String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)
  items       Item[]

  @@index([subtrate])
}

model InkType {
  id          Int     @id @default(autoincrement())
  ink_type    String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)
  items       Item[]  @relation("ItemInkType")

  @@index([ink_type])
}

model SRLamination {
  id                Int     @id @default(autoincrement())
  sr_lamination     String  @unique @db.VarChar(100)
  description       String? @db.VarChar(255)
  itemsSrLamination Item[]  @relation("ItemSrLamination")

  @@index([sr_lamination])
}

model ColorCode {
  id          Int     @id @default(autoincrement())
  color_code  String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)
  items       Item[]  @relation("ItemColor")

  @@index([color_code])
}

model BusinessUnit {
  id            Int     @id @default(autoincrement())
  business_unit String  @unique @db.VarChar(100)
  description   String? @db.VarChar(255)
  items         Item[]  @relation("ItemBusinessUnit")

  @@index([business_unit])
}

model NatureOfInk {
  id            Int     @id @default(autoincrement())
  nature_of_ink String  @unique @db.VarChar(100)
  description   String? @db.VarChar(255)
  items         Item[]  @relation("ItemNatureOfInk")

  @@index([nature_of_ink])
}

model PrintingProperty {
  id                Int     @id @default(autoincrement())
  printing_property String  @unique @db.VarChar(100)
  description       String? @db.VarChar(255)
  items             Item[]  @relation("ItemPrintingProperty")

  @@index([printing_property])
}

model PARTY_MANAGEMENT {
  id          Int     @id @default(autoincrement())
  acno        Int
  name        String  @db.VarChar(100)
  designation String? @db.VarChar(100)
  contact     String? @db.VarChar(25)
  acnoDetails ACNO    @relation(fields: [acno], references: [acno])

  @@index([acno])
  @@index([name])
  @@index([contact])
}

model Item {
  itcd                  Int                          @id @unique @default(autoincrement())
  item                  String?                      @db.VarChar(250)
  ic_id                 Int
  sku                   String?
  price                 Float?
  alternate_id          Int?
  unit                  String?                      @db.VarChar(25)
  cdate                 DateTime?                    @default(now())
  code                  String?                      @db.VarChar(50)
  subtrates             String?                      @db.VarChar(50)
  valid_from            DateTime?
  valid_to              DateTime?
  with_white            Int?
  viscosity             String?                      @db.VarChar(50)
  color_bulk            String?                      @db.VarChar(50)
  gloss                 String?                      @db.VarChar(50)
  opacity               String?                      @db.VarChar(50)
  fineness              String?                      @db.VarChar(50)
  solid                 String?                      @db.VarChar(50)
  adhesion              String?                      @db.VarChar(50)
  e                     String?                      @db.VarChar(50)
  a                     String?                      @db.VarChar(50)
  l                     String?                      @db.VarChar(50)
  b                     String?                      @db.VarChar(50)
  weight                Float?
  length                Float?
  width                 Float?
  height                Float?
  stock                 Int?
  description           String?                      @db.VarChar(500)
  wc_product_id         Int?                         @unique
  image_url             String?                      @db.VarChar(500)
  wc_parent_id          Int?
  sync_status           String?                      @default("synced")
  last_sync             DateTime?
  ink_type              String?                      @db.VarChar(100)
  lamination            String?                      @db.VarChar(100)
  series                String?                      @db.VarChar(100)
  sr                    String?                      @db.VarChar(100)
  business_unit         String?                      @db.VarChar(100)
  color                 String?                      @db.VarChar(50)
  discard               Boolean?                     @default(false)
  is_Card               Boolean?                     @default(false)
  nature_of_ink         String?                      @db.VarChar(100)
  packing_material_code Int?
  printing_property     String?                      @db.VarChar(100)
  wastage_percentage    Float?
  mc_id                 Int?
  pc_id                 Int?
  customer_code         Int?
  import_type           String?
  ltr_rate              Float?
  re_order              Int?
  future_cost_rate      Float?
  plant_id              Int? // legacy ITEM.PLANT_ID: production item this in-process item belongs to
  BomDetail             BomDetail[]
  BomMaster             BomMaster[]
  futureCosting         FutureCosting[]
  inboundDetail         InboundDetail[]
  businessUnitRef       BusinessUnit?                @relation("ItemBusinessUnit", fields: [business_unit], references: [business_unit])
  colorRef              ColorCode?                   @relation("ItemColor", fields: [color], references: [color_code])
  customerDetails       ACNO?                        @relation(fields: [customer_code], references: [acno])
  itemCategories        ItemCategory                 @relation(fields: [ic_id], references: [id])
  inkType               InkType?                     @relation("ItemInkType", fields: [ink_type], references: [ink_type])
  srLaminationRef       SRLamination?                @relation("ItemSrLamination", fields: [lamination], references: [sr_lamination])
  mainCategory          MainCategory?                @relation(fields: [mc_id], references: [id])
  natureOfInkRef        NatureOfInk?                 @relation("ItemNatureOfInk", fields: [nature_of_ink], references: [nature_of_ink])
  productCategory       ProductCategory?             @relation(fields: [pc_id], references: [id])
  printingPropertyRef   PrintingProperty?            @relation("ItemPrintingProperty", fields: [printing_property], references: [printing_property])
  subtrateRef           Subtrates?                   @relation(fields: [subtrates], references: [subtrate])
  item_qualities        Item_Quality[]
  lcDetail              LCDetail[]
  machineDetails        MACHINE_INSTRUCTION_DETAIL[]
  machineRef            MACHINE_INSTRUCTION_MASTER[]
  monthlyOpeningStock   MonthlyOpeningStock[]
  monthlyOpeningRate    MonthlyOpeningRate[]
  orderMaster           OrderDetail[]
  qualityMaster         QualityMaster[]
  receipeDetail         RECEIPE_DETAIL[]
  receipeMasters        RECEIPE_MASTER[]
  ReqDetail             ReqDetail[]
  salesForecast         SALES_FORECAST[]             @relation("ITEM_SALES_FORECAST")
  salesItemCust         SALES_ITEM_CUST[]
  Transactions          Transactions[]               @relation("ItemRelation")
  TransactionsPacking   Transactions[]               @relation("PackingRelation")
  productionPlanDetail  productionPlanDetail[]
  productionPlanMaster  productionPlanMaster[]
  rmcInputRate          RmcInputRate?
  grn_direct_rate        Boolean  @default(false) // rate entered on the GRN, not taken from the PO (Features: grn.directRateByItem)
  re_order_level         Float?
  minimum_order_quantity Float?
  inputForPP             InputForPP[]

