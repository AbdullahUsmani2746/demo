model Transactions {
  id                    Int                @id @default(autoincrement())
  tran_id               Int
  acno                  Int?
  itcd                  Int?
  ccno                  Int?
  po_qty                Float?
  so_qty                Float?
  narration1            String?            @db.VarChar(250)
  narration2            String?            @db.VarChar(250)
  narration3            String?            @db.VarChar(150)
  narration4            String?            @db.VarChar(150)
  narration5            String?            @db.VarChar(150)
  chno                  String?            @db.VarChar(150)
  check_date            DateTime?
  party_name            String?            @db.VarChar(150)
  stock                 Int?
  unit                  String?            @db.VarChar(25)
  damt                  Float?
  camt                  Float?
  qty                   Float? // ALWAYS KILOGRAMS — every stock calculation reads this. On a `unit`="LTR" line it is derived: qty_ltr * Item.ltr_rate
  qty_ltr               Float? // Litres. Source of truth on a `unit`="LTR" line, and the basis its amount is priced on. See lib/units/litres.js
  ack_qty               Float? // Acknowledged qty, in the line's BILLING unit (litres on a LTR line). NULL = the billable qty (qty / qty_ltr). Set by Invoicing (lib/invoicing/core.js); the invoice is priced on it. Stock never reads it.
  original_qty          Float? // Add this line to track original quantity for returns
  rate                  Float?
  wht_rate              Float?
  st_rate               Float?
  godown                Int?
  invoice_no            String?            @db.VarChar(150)
  sub_tran_id           Int?               @default(1)
  currency              Int?
  gross_amount          Float?
  fc_amount             Float?
  no_of_pack            Float?
  qty_per_pack          Float?
  st_amount             Float?
  additional_tax        Float?
  packing_material_code Int?
  req_qty               Float?
  service_id            Int?
  batch_no              String?            @db.VarChar(250)
  returnable            Boolean?           @default(false)
  additional_tax_amount Float?
  asset_no              Int?               @unique
  tax_amount            Float?
  // Auto Material Issue / Production made by a dispatch: the dispatch line
  // (1-based) this row belongs to (lib/dispatch/bomProduction.js).
  source_line_no        Int?
  // rmk1..rmk13: raw legacy line columns from the SMS_46,13,14 import (see scripts/sql/sms-46-13-14-import.sql header)
  rmk1                  String?
  rmk2                  String?
  rmk3                  String?
  rmk4                  String?
  rmk5                  String?
  rmk6                  String?
  rmk7                  String?
  rmk8                  String?
  rmk9                  String?
  rmk10                 String?
  rmk11                 String?
  rmk12                 String?
  rmk13                 String?
  split_from_line_id    Int?
  // Files attached to this line (public URLs) — /api/voucher/attachments with lineId.
  // The document's own files are TransactionsMaster.attachments.
  attachments           String[]           @default([])
  invoiceKnockoffs      InvoiceKnockoff[]  @relation("KnockoffSourceLine")
  acnoDetails           ACNO?              @relation(fields: [acno], references: [acno])
  costCenter            CostCenter?        @relation(fields: [ccno], references: [ccno])
  currencyDetails       Currency?          @relation(fields: [currency], references: [id])
  godownDetails         Godown?            @relation(fields: [godown], references: [id])
  itemDetails           Item?              @relation("ItemRelation", fields: [itcd], references: [itcd])
  packingDetails        Item?              @relation("PackingRelation", fields: [packing_material_code], references: [itcd])
  serviceDetails        Service?           @relation(fields: [service_id], references: [id])
  splitFromLine         Transactions?      @relation("LineSplit", fields: [split_from_line_id], references: [id])
  splitSlices           Transactions[]     @relation("LineSplit")
  transactionsMaster    TransactionsMaster @relation(fields: [tran_id], references: [tran_id])
  line_type        String? @db.VarChar(10) // dispatch line: TRIAL / RATE_NEG from its Sale Order line; null = normal
  plan_no          Int? // dispatch line: Production Plan it came from
  process_order_no Int? // dispatch line: Process Order that produced it
  sub_account      String? @db.VarChar(250) // voucher line sub account (Features: vouchers.subAccounts)
  cost_rate        Float? // sale return: cost the stock comes back at
  tax_law_code     Int? // line withholding tax law (Features: tax.lineWht)
  taxLaws               TaxLaws?           @relation(fields: [tax_law_code], references: [tax_law_code])

  @@index([tran_id])
  @@index([acno])
  @@index([split_from_line_id])
  @@index([itcd])
  @@index([packing_material_code])
  @@index([ccno])
  @@index([godown])
  @@index([currency])
  @@index([rate])
  @@index([qty])
  @@index([damt, camt])
  @@index([invoice_no])
}

