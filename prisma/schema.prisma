// ============================================================
// AUTHORISATION
// ------------------------------------------------------------
// Three layers on top of the existing menu access (employee_menu):
//   Permission / PermissionGrant  — may this user perform an action?
//   FieldPolicy                   — may they see / edit a given field?
//   DataScope                     — which rows may they see or touch?
//
// ADMIN and ACCOUNTANT bypass all three unconditionally — see
// FULL_ACCESS_ROLES in lib/auth/permissions.js. Everyone else is
// DEFAULT DENY: nothing is permitted until it is granted.
// ============================================================

/// The catalogue of controllable actions. Seeded from VOUCHER_CONFIG and
/// REPORT_CONFIG by scripts/seed-permissions.mjs — not edited by users.
model Permission {
  id     Int               @id @default(autoincrement())
  code   String            @unique @db.VarChar(120) // "saleOrder.create"
  module String            @db.VarChar(60) // groups the admin screen
  label  String            @db.VarChar(200)
  sort   Int               @default(0)
  grants PermissionGrant[]

  @@index([module])
}

/// Who holds a permission. Grant to a ROLE (broad) or a USER (specific).
/// allow=false is an explicit DENY and always wins over any ALLOW.
/// `constraints` carries optional limits, e.g.
///   { "maxAmount": 500000, "backdateDays": 3, "godowns": [1,2] }
model PermissionGrant {
  id           Int        @id @default(autoincrement())
  permissionId Int
  userId       String?
  role         String?    @db.VarChar(40) // app_roles.code
  allow        Boolean    @default(true)
  constraints  Json?
  grantedById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy    User?      @relation("PermissionGrantedBy", fields: [grantedById], references: [id])

  @@unique([permissionId, userId])
  @@unique([permissionId, role])
  @@index([userId])
  @@index([role])
}

/// Field-level visibility. access: HIDDEN | READONLY | EDIT.
/// Enforced server-side (the API strips or refuses the field) and read by the
/// form engine to hide or disable the input.
model FieldPolicy {
  id     Int     @id @default(autoincrement())
  entity String  @db.VarChar(60) // "ACNO" | "SALES_ITEM_CUST" | "Employee"
  field  String  @db.VarChar(60) // "rate" | "crLimit"
  access String  @db.VarChar(10)
  userId String?
  role   String? @db.VarChar(40) // app_roles.code
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entity, field, userId])
  @@unique([entity, field, role])
  @@index([entity])
}

/// Row-level scope, one row per user per dimension.
/// mode: ALL (everything) | OWN (resolved from the data — customers whose
/// sales person is this user, orders they created) | LIST (explicit values).
model DataScope {
  id        String   @id @default(cuid())
  userId    String
  dimension String   @db.VarChar(30) // "customer" | "region" | "godown"
  mode      String   @db.VarChar(10)
  values    String[] @default([])
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dimension])
  @@index([userId])
}

/// Role catalogue — Admin → Roles (lib/auth/roleCatalog.js). Only ADMIN
/// (Super Admin) skips permission checks (lib/auth/roles.js).
/// prisma/sql/2026-11-16_roles.sql
model AppRole {
