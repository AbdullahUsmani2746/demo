// One production (finished) item of a process order. Line 1 is mirrored on
// productionPlanMaster (finished_id / qty / batch_no / bom_id / actual_yield)
// so single-item consumers keep working. Posted tran_code 8 lines carry
// Transactions.source_line_no = line_no. See lib/manufacturing/processOrder.js.
model productionPlanOutput {
  id           Int                  @id @default(autoincrement())
  plan_id      Int
  line_no      Int
  finished_id  Int?
  bom_id       Int?
  qty          Float?
  actual_yield Float?
  unit         String?              @db.VarChar(25)
  godown       Int?
  batch_no     String?              @db.VarChar(50)
  plan         productionPlanMaster @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@unique([plan_id, line_no])
  @@index([finished_id])
}

// Issue godown / unit of one productionPlanDetail row and the production item
// (productionPlanOutput.line_no) it is issued for. Posted tran_code 7 lines
// carry Transactions.source_line_no = output_line.
model productionPlanIssue {
  id          Int                  @id @default(autoincrement())
  plan_id     Int
  detail_id   Int                  @unique
  output_line Int                  @default(1)
  godown      Int?
  unit        String?              @db.VarChar(25)
  plan        productionPlanMaster @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  detail      productionPlanDetail @relation(fields: [detail_id], references: [id], onDelete: Cascade)

  @@index([plan_id])
}

